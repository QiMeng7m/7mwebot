# === AI Backend: "claude" | "deepseek" | "openai" ===
AI_BACKEND=deepseek

# === Claude / Anthropic (only needed if AI_BACKEND=claude) ===
ANTHROPIC_API_KEY=
# Anthropic API Base URL (可填兼容代理/中转服务)
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model: claude-haiku-4-5-20251001 (fast/cheap) or claude-sonnet-4-5-20250929 (better quality)
SUMMARIZE_MODEL=claude-haiku-4-5-20251001

# === DeepSeek (only needed if AI_BACKEND=deepseek) ===
# 在此填入你的 DeepSeek API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek API Base URL (可填 OpenAI-compatible 代理/中转服务)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型: deepseek-v4-flash (推荐, 极速/极低价格) 或 deepseek-v4-pro (1M上下文, 旗舰)
DEEPSEEK_MODEL=deepseek-v4-flash

# === OpenAI 兼容 (only needed if AI_BACKEND=openai) ===
# 任意 OpenAI 兼容服务商: OpenAI / GLM(智谱) / Moonshot / Qwen 等。
OPENAI_API_KEY=
# Base URL，GLM 填 https://open.bigmodel.cn/api/paas/v4/，OpenAI 官方填 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# 模型名，如 gpt-4o-mini / glm-4-flash / moonshot-v1-8k
OPENAI_MODEL=gpt-4o-mini

# === WeChat 数据目录（可选，留空则自动检测）===
# 如果微信聊天记录不在默认路径（Documents\xwechat_files 或 Documents\WeChat Files），
# 请在此填写包含 wxid_* 文件夹的父目录绝对路径。
# 例如: D:\WeChatData 或 C:\Users\xxx\AppData\Roaming\Tencent\WeChat
WECHAT_DATA_DIR=

# === WeChat Backend ===
# Windows: wcdb. macOS: mac_hybrid (WeFlow WCDB read + Accessibility send) or mac_ui fallback.
WECHAT_BACKEND=wcdb
# Optional: override the detected macOS WeChat account data directory.
MAC_WEFLOW_DATA_DIR=
# macOS WeChat send shortcut: enter or cmd_enter.
MAC_WECHAT_SEND_SHORTCUT=enter
# Comma-separated group names. "*" = auto-discover all groups.
WECHAT_GROUPS=
# wcdb_api.dll 内置到期检查（InitProtection / wcdb_init）。
# 1=运行时放宽到期检查（默认，仅修改进程内存，不改磁盘 DLL）；0=关闭。
WCDB_PATCH_EXPIRY=1

# === Bot Identity ===
# Your bot's WeChat display name. Used for @mention detection.
BOT_DISPLAY_NAME=群聊小助手
# Additional names the bot answers to (e.g. the group nickname members @).
# Comma-separated. Leave empty if none.
BOT_ALIASES=

# === Trigger Keywords ===
# Comma-separated. The bot also responds to @mentions regardless of keywords.
TRIGGER_KEYWORDS=总结一下,之前发了什么,错过了什么,summarize,what did i miss,聊天总结,帮我总结,前面说了什么,说了啥,发生了什么

# === Database ===
DB_PATH=data/messages.db

# === Features ===

# 趣味功能 — @机器人抽签，返回随机运势签文（true/false）
FUN_ENABLED=true

# === Activity Points / Equipment / Duels ===
# 群内发言赚积分；累计积分决定榜单与等级，余额用于购买装备和免战券。
POINTS_ENABLED=true
# 逗号分隔的群名；* 表示所有群
POINTS_GROUPS=*
POINTS_BASE_SCORE=1
POINTS_LENGTH_MIN_CHARS=20
POINTS_LENGTH_BONUS=1
POINTS_LONG_LENGTH_MIN_CHARS=100
POINTS_LONG_LENGTH_BONUS=1
POINTS_MEDIA_BONUS=1
POINTS_REPLY_BONUS=2
POINTS_DAILY_FIRST_BONUS=10
POINTS_PER_MESSAGE_CAP=5
POINTS_RATE_LIMIT_PER_MIN=8
POINTS_DAILY_CAP=80
POINTS_MAX_AGE_SEC=300
POINTS_BOARD_SIZE=10
POINTS_LEVELS_PATH=data/point_levels.json

EQUIPMENT_ENABLED=true
EQUIPMENT_PATH=data/equipment.json

# 切磋：胜率随武力差上升但封顶 92%；差距越大抢分越少
DUEL_ENABLED=true
DUEL_GROUPS=*
DUEL_PROB_K=1.15
DUEL_MIN_PROB=0.08
DUEL_MAX_PROB=0.92
DUEL_BASE_STEAL_RATIO=0.08
DUEL_REWARD_K=1.2
DUEL_PER_FIGHT_CAP=20
DUEL_DAILY_ATTEMPTS=10
DUEL_PAIR_DAILY_ATTEMPTS=5
DUEL_DAILY_STEAL_CAP=50
DUEL_PAIR_COOLDOWN_SEC=300
DUEL_LOSS_COOLDOWN_SEC=120
DUEL_NOVICE_PROTECTION_POINTS=20
SHIELD_PRICE=20
SHIELD_DURATION_SEC=14400
SHIELD_MAX_SEC=86400

# === Fishing (钓鱼) ===
# 钓鱼只增加余额，不增加累计积分/等级/榜单。
FISHING_ENABLED=true
FISHING_GROUPS=*
FISHING_CATALOG_PATH=data/fishing.json
FISHING_DAILY_ATTEMPTS=30
# 每人每日钓鱼入账上限（0 = 不限制）
FISHING_DAILY_CAP=0
FISHING_COOLDOWN_SEC=5
FISHING_MAX_BATCH=10
FISHING_MISS_CHANCE=0.15

# === World Boss / 群副本 ===
# 每周一个 Boss，HP 按群成员数缩放；击杀奖励按伤害占比分配余额。
BOSS_ENABLED=true
BOSS_GROUPS=*
BOSS_COOLDOWN_SEC=1800
BOSS_MAX_ATTEMPTS=3
BOSS_HP_PER_MEMBER=600
BOSS_MIN_HP=3000
BOSS_MAX_HP=30000
# 击杀奖励池 = Boss 总血量 × 该比例
BOSS_REWARD_RATIO=0.15

# === Daily Lottery / 每日抽奖 ===
# 每次抽奖消耗余额；奖池包含积分、余额、装备、鱼竿、鱼饵、免战券。
LOTTERY_ENABLED=true
LOTTERY_GROUPS=*
LOTTERY_COST=100
LOTTERY_DAILY_ATTEMPTS=3

# === Feishu Knowledge Base ===
# 开启后，@机器人说“同步到飞书”等触发词会自动创建/维护一个多维表格知识库。
FEISHU_EXPORT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EXPORT_MODE=knowledge
FEISHU_EXPORT_WINDOW_HOURS=8
FEISHU_EXPORT_TRIGGER_KEYWORDS=同步到飞书,导出到飞书,写到飞书,沉淀到飞书
# 开启后，最近窗口消息数达到阈值时会无感自动沉淀，不回群消息。
FEISHU_AUTO_SYNC_ENABLED=false
FEISHU_AUTO_SYNC_MIN_MESSAGES=20
FEISHU_AUTO_SYNC_COOLDOWN_SEC=1800
FEISHU_KNOWLEDGE_BASE_NAME=webot 群聊沉淀
# 可选：指定飞书文件夹 token；留空则使用应用默认创建位置。
FEISHU_KNOWLEDGE_FOLDER_TOKEN=

# === Tuning ===
# Seconds between message polls (default: 1.0, increase for lower CPU usage)
POLL_INTERVAL_SEC=1.0
# Minimum seconds between trigger responses in the same chat (dedup)
DEDUP_WINDOW_SEC=60
# Max messages to include in summary prompt.
# For groups with 999+ messages, increase this value.
# The bot uses token estimation + automatic chunking (map-reduce) to handle
# very large conversations safely within the model's context window.
MAX_MESSAGES_FOR_SUMMARY=5000
# Messages per chunk when map-reduce is triggered (default: 400)
CHUNK_SIZE=400
# If requester has no prior message, or the detected window is too small,
# expand to this many hours (minimum summary window)
FALLBACK_WINDOW_HOURS=8
# API 调用失败时的最大重试次数（1-10）
MAX_RETRIES=3

# === Welcome New Member ===
# Master switch — automatically send a welcome message when a new
# member joins a group chat. Templates and per-group settings are
# stored in data/welcome_templates.json.
WELCOME_ENABLED=false

# === Proactive Participation ===
# Master switch — enable autonomous chat participation without @mention
PROACTIVE_ENABLED=false
# Rate calculation window in seconds (default: 120 = 2 minutes)
PROACTIVE_RATE_WINDOW_SEC=120
# Message rate thresholds (msgs/min) for each mode.
# Calibrate by running: python tools/analyze_chat_rhythm.py
PROACTIVE_RATE_QUIET=1.5
PROACTIVE_RATE_CASUAL=4.0
PROACTIVE_RATE_LIVELY=6.5
PROACTIVE_RATE_BURST=8.5

# === Sticky Mention ===
# When a user sends @bot with no message text, the bot enters sticky
# listening mode.  The user's next message in the same group is treated
# as if it were @mentioned (one-shot — consumed on first non-empty follow-up).
# Set to false to disable entirely.
STICKY_MENTION_ENABLED=true
# Max seconds to wait for the follow-up message after an empty @mention
STICKY_MENTION_TTL_SEC=60

# === Logging ===
LOG_LEVEL=INFO
# Optional log file (leave empty for console only)
LOG_FILE=data/bot.log
